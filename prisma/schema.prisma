// Kidoclassic store schema.
//
// The one decision that matters here: price and stock live on ProductVariant,
// never on Product. A product is a name and some photos. A variant is the thing
// a customer actually buys and the thing you actually count in a stockroom.
// Everything downstream (cart, orders, the admin grid) hangs off that.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id String @id @default(cuid())

  // Cards show the brand above the product name: "Roadster" then
  // "Printed Cotton T-Shirt". Optional, because not everything is branded.
  brand       String?
  name        String
  slug        String   @unique
  description String?  @db.Text
  // A JSON array of URLs, ordered, first one is the card image. MySQL has no
  // scalar list type, so read it through imageList() rather than trusting it.
  images      Json?
  /// One showcase video shown alongside the photos on the product page.
  videoUrl    String?  @db.Text
  status      Status   @default(DRAFT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants ProductVariant[]
  wishedBy WishlistItem[]
  reviews  Review[]
  storyItems StoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Saved for later. Keyed by the same cookie as the cart until logins exist.
model WishlistItem {
  id        String  @id @default(cuid())
  sessionId String?
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
  @@index([userId])
}

model Notification {
  id        String  @id @default(cuid())
  sessionId String?
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   String
  title  String
  body   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String
  color String?
  /// Additional custom variation key-value pairs (e.g., {"Material": "Silk", "Style": "Slim Fit"})
  customOptions Json?

  // Kobo, not Naira. Storing money as an integer of the smallest unit avoids
  // every floating point rounding bug you would otherwise hit at checkout.
  priceKobo Int

  // The struck-through "was" price on the card. Never charge from this field,
  // and leave it null when the item is not discounted.
  compareAtKobo Int?

  stock     Int    @default(0)
  sku       String? @unique

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, size, color])
  @@index([productId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         Role      @default(CUSTOMER)
  orders        Order[]
  carts         Cart[]
  addresses     Address[]
  wishlist      WishlistItem[]
  notifications Notification[]
  sessions      Session[]
  reviews       Review[]
  passwordResets PasswordResetToken[]

  /// Lets a super admin switch off a staff account without deleting its history.
  isActive      Boolean  @default(true)
  /// Set to true when the user clicks the link in their verification email.
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
}

/// The customer's address book. Orders copy these fields rather than pointing
/// at a row, so editing an address here never rewrites a past order.
model Address {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guests get an address book too, keyed by the same cookie the cart uses.
  sessionId String?

  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  percentOff    Int?
  amountOffKobo Int?
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

enum Role {
  CUSTOMER
  /// Shop staff: products, orders, categories, discounts, review moderation.
  ADMIN
  /// Everything ADMIN can do, plus managing who the staff are.
  SUPER_ADMIN
}

/// Opaque server-side sessions rather than a signed token, so signing someone
/// out actually revokes their access instead of waiting for an expiry.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Short-lived OTP codes for the forgot-password flow. Each row is one request;
/// usedAt is set when the code is consumed so it cannot be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating Int
  title  String?
  body   String  @db.Text

  /// Nothing is public until a member of staff approves it.
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?

  createdAt DateTime @default(now())

  /// One review per customer per product.
  @@unique([productId, userId])
  @@index([status])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // guests, cookie-backed
  items     CartItem[]

  /// Where to send an abandoned-cart nudge. Filled in from the signed-in user,
  /// or from a guest's checkout email once they reach the payment step — a
  /// guest cart with no email simply cannot be followed up.
  email               String?
  /// Stamped when a follow-up goes out, so nobody is emailed about the same
  /// cart twice.
  recoveryEmailSentAt DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id     String      @id @default(cuid())
  userId String?
  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest orders are found again through the same cookie as the cart, so order
  // history works before there is any login.
  sessionId String?

  email  String
  phone  String?
  status OrderStatus @default(PENDING)

  // Every figure here is recomputed server-side from variant prices at checkout.
  // Never trust a total sent from the browser.
  subtotalKobo Int
  deliveryKobo Int @default(0)
  discountKobo Int @default(0)
  discountCode String?
  totalKobo    Int

  paymentMethod String?

  // Shipping address kept as plain fields rather than a relation: an order is a
  // historical record and must not change when a customer later edits her
  // saved address.
  recipientName String?
  addressLine   String?
  line2         String?
  city          String?
  state         String?
  postalCode    String?

  // Set from the ALAT Pay webhook, not from the redirect back to the site.
  paymentRef String?   @unique
  paidAt     DateTime?

  /// Stamped when an unpaid-order follow-up is sent, so a customer is nudged
  /// once rather than on every sweep.
  recoveryEmailSentAt DateTime?
  /// Stamped when the paid receipt goes out, so re-confirming or a second
  /// webhook delivery cannot send a duplicate receipt.
  receiptSentAt       DateTime?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int

  // Frozen at purchase. If you raise a price next month, last month's receipt
  // must still say what she actually paid.
  priceKobo   Int
  productName String
  size        String
  color       String?
  customOptions Json?
}

/// Display currencies for the storefront.
///
/// Prices are stored once, in kobo, and converted for display only. The charge
/// is always NGN because that is what the payment processor settles in, so a
/// rate being briefly stale changes what a shopper reads, never what they pay.
model Currency {
  id     String @id @default(cuid())
  code   String @unique
  symbol String
  name   String

  /// How many units of this currency one naira buys. NGN itself is 1.
  unitsPerNaira Float

  /// When true a rate refresh overwrites unitsPerNaira from the live feed.
  /// Turn it off to pin a rate you set by hand.
  autoRate Boolean @default(true)

  /// When the live feed last wrote this rate, so staleness is visible.
  rateUpdatedAt DateTime?

  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Single row of shop-wide settings. Kept as one row rather than a key/value
/// table so the values stay typed and a missing setting cannot mean "free".
model StoreSettings {
  id String @id @default("singleton")

  /// Flat delivery charge in kobo.
  deliveryFlatKobo Int @default(250000)

  /// Order value in kobo above which delivery is free. Set high to disable.
  freeDeliveryOverKobo Int @default(15000000)

  // --- Home page hero, editable from the admin ---
  heroEyebrow   String? @db.Text
  heroTitle     String? @db.Text
  heroSubtitle  String? @db.Text
  heroCtaLabel  String?
  heroCtaHref   String?
  /// The hero is two equal halves, each its own background image.
  heroLeftImage  String? @db.Text
  heroRightImage String? @db.Text

  // --- WhatsApp chat button. Hidden entirely until switched on here. ---
  whatsappEnabled Boolean @default(false)
  whatsappNumber  String?
  /// Prefilled text the shopper sends. Blank means an empty message.
  whatsappMessage String? @db.Text

  // --- Abandoned checkout follow-up ---
  abandonedEmailEnabled Boolean @default(false)
  /// How long a cart or unpaid order sits before it counts as abandoned.
  abandonedAfterHours   Int     @default(24)

  updatedAt DateTime @updatedAt
}

/// Newsletter signups from the footer.
model Subscriber {
  id    String @id @default(cuid())
  email String @unique

  /// Where the signup came from, so a future form can be told apart.
  source String @default("footer")

  /// Kept rather than deleted, so a re-signup does not silently resurrect
  /// someone who asked to be removed.
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([unsubscribedAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String? @db.Text
  body    String  @db.Text

  coverImage String?
  status     PostStatus @default(DRAFT)

  /// Set when first published, so reordering drafts does not disturb the feed.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Editable standalone pages — Our Story, Contact Us, and anything similar.
/// Seeded by slug rather than created freely, so the footer can link to a known
/// address that always resolves.
model SitePage {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  body    String @db.Text

  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// The "Deals of the Month" block on the home page, including its countdown.
model Deal {
  id       String  @id @default(cuid())
  title    String
  body     String? @db.Text
  imageUrl String?

  /// What the countdown counts down to. Past this the block stops showing a
  /// clock rather than counting upward.
  endsAt DateTime

  ctaLabel String  @default("View all products")
  ctaHref  String  @default("/shop")
  active   Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([active])
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Instagram-style stories section on the home page and admin dashboard.
model Story {
  id          String   @id @default(cuid())
  title       String
  brandHandle String   @default("@kidoclassic")
  coverImage  String
  active      Boolean  @default(true)
  position    Int      @default(0)

  slides StoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([position])
}

/// Individual slide/item inside a Story. Can attach a store Product.
model StoryItem {
  id          String    @id @default(cuid())
  storyId     String
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  mediaUrl    String
  mediaType   MediaType @default(IMAGE)
  caption     String?
  durationSec Int       @default(5)
  position    Int       @default(0)

  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([productId])
  @@index([position])
}

/// The four promises under the home page, and the footer link columns.
/// Editable so the copy cannot drift from what the shop actually offers —
/// the free-delivery line in particular has to match StoreSettings.
model ValueProp {
  id       String @id @default(cuid())
  icon     String @default("truck")
  title    String
  body     String
  position Int    @default(0)
  active   Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([active, position])
}

/// A link in one of the footer columns.
model FooterLink {
  id    String @id @default(cuid())
  /// "information" or "service" — which column it belongs to.
  column   String
  label    String
  href     String
  position Int    @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([column, position])
}
