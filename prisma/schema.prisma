// Kidoclassic store schema.
//
// The one decision that matters here: price and stock live on ProductVariant,
// never on Product. A product is a name and some photos. A variant is the thing
// a customer actually buys and the thing you actually count in a stockroom.
// Everything downstream (cart, orders, the admin grid) hangs off that.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id String @id @default(cuid())

  // Cards show the brand above the product name: "Roadster" then
  // "Printed Cotton T-Shirt". Optional, because not everything is branded.
  brand       String?
  name        String
  slug        String   @unique
  description String?  @db.Text
  // A JSON array of URLs, ordered, first one is the card image. MySQL has no
  // scalar list type, so read it through imageList() rather than trusting it.
  images      Json?
  status      Status   @default(DRAFT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants ProductVariant[]
  wishedBy WishlistItem[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Saved for later. Keyed by the same cookie as the cart until logins exist.
model WishlistItem {
  id        String  @id @default(cuid())
  sessionId String?
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
  @@index([userId])
}

model Notification {
  id        String  @id @default(cuid())
  sessionId String?
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   String
  title  String
  body   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String
  color String?

  // Kobo, not Naira. Storing money as an integer of the smallest unit avoids
  // every floating point rounding bug you would otherwise hit at checkout.
  priceKobo Int

  // The struck-through "was" price on the card. Never charge from this field,
  // and leave it null when the item is not discounted.
  compareAtKobo Int?

  stock     Int    @default(0)
  sku       String? @unique

  cartItems  CartItem[]
  orderItems OrderItem[]

  // One row per size/color combination per product.
  @@unique([productId, size, color])
  @@index([productId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         Role      @default(CUSTOMER)
  orders        Order[]
  carts         Cart[]
  addresses     Address[]
  wishlist      WishlistItem[]
  notifications Notification[]
  sessions      Session[]
  reviews       Review[]

  /// Lets a super admin switch off a staff account without deleting its history.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// The customer's address book. Orders copy these fields rather than pointing
/// at a row, so editing an address here never rewrites a past order.
model Address {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guests get an address book too, keyed by the same cookie the cart uses.
  sessionId String?

  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  percentOff    Int?
  amountOffKobo Int?
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

enum Role {
  CUSTOMER
  /// Shop staff: products, orders, categories, discounts, review moderation.
  ADMIN
  /// Everything ADMIN can do, plus managing who the staff are.
  SUPER_ADMIN
}

/// Opaque server-side sessions rather than a signed token, so signing someone
/// out actually revokes their access instead of waiting for an expiry.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating Int
  title  String?
  body   String  @db.Text

  /// Nothing is public until a member of staff approves it.
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?

  createdAt DateTime @default(now())

  /// One review per customer per product.
  @@unique([productId, userId])
  @@index([status])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // guests, cookie-backed
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id     String      @id @default(cuid())
  userId String?
  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest orders are found again through the same cookie as the cart, so order
  // history works before there is any login.
  sessionId String?

  email  String
  phone  String?
  status OrderStatus @default(PENDING)

  // Every figure here is recomputed server-side from variant prices at checkout.
  // Never trust a total sent from the browser.
  subtotalKobo Int
  deliveryKobo Int @default(0)
  discountKobo Int @default(0)
  discountCode String?
  totalKobo    Int

  paymentMethod String?

  // Shipping address kept as plain fields rather than a relation: an order is a
  // historical record and must not change when a customer later edits her
  // saved address.
  recipientName String?
  addressLine   String?
  line2         String?
  city          String?
  state         String?
  postalCode    String?

  // Set from the ALAT Pay webhook, not from the redirect back to the site.
  paymentRef String?   @unique
  paidAt     DateTime?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([sessionId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int

  // Frozen at purchase. If you raise a price next month, last month's receipt
  // must still say what she actually paid.
  priceKobo   Int
  productName String
  size        String
  color       String?
}
