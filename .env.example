# Copy to .env and fill in. Never commit .env.

# Hostinger: hPanel > Databases > MySQL Databases. Use localhost as the host
# once the app is deployed, since the Node app and the database sit on the same
# plan; use the server hostname while connecting from your laptop.
DATABASE_URL="mysql://user:password@localhost:3306/database"

# A second, empty database. `prisma migrate dev` needs somewhere to rebuild the
# schema for comparison, and shared hosting will not let it create one itself.
# Only needed on your machine — leave it unset in the Hostinger panel.
SHADOW_DATABASE_URL=""

# Shared secret for the placeholder admin gate in lib/auth.ts
ADMIN_SECRET=""
